{
  "name": "taki",
  "private": true,
  "description": "TAKI Travel monorepo tooling. The web app lives in apps/web (own package.json + lockfile); Firebase config in firebase/.",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "npm --prefix apps/web run test",
    "check": "npm --prefix apps/web run check",
    "emulators": "npm --prefix apps/web run emulators",
    "test:e2e:build": "npm --prefix apps/web run test:e2e:build",
    "test:e2e": "npm --prefix apps/web run test:e2e --",
    "rules:deploy": "npm --prefix apps/web run rules:deploy",
    "dev:all": "node scripts/dev.mjs"
  }
}
