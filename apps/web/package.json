{
  "name": "taki-travel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:build": "next build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "emulators": "firebase emulators:start --config ../../firebase/firebase.json --only auth,firestore,storage --project demo-taki --import=../../firebase/.data/emulators --export-on-exit",
    "rules:deploy": "firebase deploy --config ../../firebase/firebase.json --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@cashfreepayments/cashfree-js": "^1.0.7",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@hookform/resolvers": "^7.0.5",
    "clsx": "^2.1.1",
    "firebase": "^13.3.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
