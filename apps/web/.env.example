# TAKI v2 — environment variables (names only; never commit real values).
# Development defaults for the Firebase Emulator Suite live in .env.development (committed, no secrets).
# Copy this file to .env.local and fill in secrets.

# ── Firebase (server-only; the browser never talks to Firebase) ──────────────
FIREBASE_PROJECT_ID=demo-taki
# Production only (or GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=demo-taki.appspot.com
# Emulator hosts — MUST be unset in production:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ── App ──────────────────────────────────────────────────────────────────────
APP_ORIGIN=http://localhost:3000
# >= 32 random bytes, base64. Dev generates one per process (with a warning) if missing.
SESSION_SECRET=
# >= 32 random bytes. Used to HMAC identity-document numbers. NEVER rotate in production.
PII_HASH_KEY=
# Bearer secret for POST /api/internal/sweep (cron).
CRON_SECRET=
# true on Vercel (trust first x-forwarded-for hop for rate limits).
TRUST_PROXY_HEADERS=false

# ── SMS / OTP ────────────────────────────────────────────────────────────────
# dev (shows "Dev OTP" on screen; refused in production) | msg91
SMS_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_NOTIFY_TEMPLATE_ID=
SMS_NOTIFICATIONS=false

# ── Payments ─────────────────────────────────────────────────────────────────
# dev (explicit Approve/Decline page, no money moves; refused in production) | cashfree
PAYMENT_PROVIDER=dev
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01

# ── Behaviour flags ──────────────────────────────────────────────────────────
# Non-production only: verify agencies at signup so e2e is not blocked.
DEV_AUTO_VERIFY_AGENCIES=false
# Local testing only: fixed OTPs — phone 123456, pickup 111111, delivery 222222 (docs/DEMO_LOGINS.md).
# The server refuses to start in production if this is set.
DEV_FIXED_OTPS=false
REQUIRE_DELIVERY_PROOF=true

# ── Seed / ops guards ────────────────────────────────────────────────────────
# Blank = the documented dev default (Taki@2026). Never used in production.
SEED_PASSWORD=
SEED_ALLOW_REMOTE=
FIREBASE_PROD_PROJECT_ID=
# Only for Playwright against `next start` + emulator (never in a real deployment).
TAKI_E2E=
