# TAKI web (apps/web): browser configuration. Names only; never commit real values.
# Every NEXT_PUBLIC_* value is inlined into the JavaScript bundle at BUILD time (App Hosting: availability
# BUILD + RUNTIME, see apphosting.yaml). Local defaults for the Firebase emulators are in .env.development.

# ── Environment label ───────────────────────────────────────────────────────────
# local | staging | production
NEXT_PUBLIC_APP_ENV=local

# ── API (FastAPI) ───────────────────────────────────────────────────────────────
# Origin of the API, e.g. https://api.taki.example (the browser calls {base}/api/v1/...).
# Empty = same origin: next.config.ts rewrites /api/v1/* to API_PROXY_TARGET (dev / e2e only).
NEXT_PUBLIC_API_BASE_URL=
# Server-side only: where the /api/v1 rewrite points. Default in `next dev`: http://127.0.0.1:8000.
# Leave unset in production (the browser calls NEXT_PUBLIC_API_BASE_URL directly).
API_PROXY_TARGET=

# ── Firebase JS SDK (Auth only; the browser never touches Firestore or Storage) ─
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local / e2e only: host:port of the Auth emulator (no real SMS; reCAPTCHA bypassed). Unset everywhere else.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# ── Google Maps (browser key: Maps JavaScript API + Places API (New), HTTP-referrer restricted) ─
# Unset → address/town inputs fall back to server geocoding (E23) and maps to the SVG route sketch.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Optional cloud map style id (needed for advanced markers).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Dev payment gateway page ────────────────────────────────────────────────────
# true only for local / e2e builds whose API runs PAYMENT_PROVIDER=dev. Never in staging or production.
NEXT_PUBLIC_ENABLE_DEV_GATEWAY=false
