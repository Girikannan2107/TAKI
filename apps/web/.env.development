# TAKI web — committed development defaults (NO secrets). Loaded by `next dev`.
# Firebase emulators (auth 9099) + FastAPI on http://127.0.0.1:8000 (proxied at /api/v1 by next.config.ts).
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=
# A demo-* project needs no real credentials; the emulator accepts any API key.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-taki.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-taki
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_ENABLE_DEV_GATEWAY=true
