# TAKI API (FastAPI) environment. Copy to backend/.env for local development:
#   cp backend/.env.example backend/.env
# Placeholders only: never commit real values. In staging/production every secret comes from
# Google Secret Manager (see docs/v3/deploy.md). Names match app/core/config.py exactly.

# ── Runtime ─────────────────────────────────────────────────────────────────────────────────
# development | test | staging | production   ("local" is accepted as an alias of development)
APP_ENV=development
LOG_LEVEL=INFO
# JSON logs (Cloud Logging format). Set false for readable local logs.
LOG_JSON=false

# ── Firebase / Google Cloud ─────────────────────────────────────────────────────────────────
# Emulators: a demo-* project id is required whenever an *_EMULATOR_HOST is set.
FIREBASE_PROJECT_ID=demo-taki
# Default: <project>.appspot.com (emulator). Production: <project>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=demo-taki.appspot.com
# Local emulators (started by `node scripts/dev.mjs`). MUST be unset in staging/production
# (the API refuses to start in production when any of these is set).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Only for tests/scripts that exchange custom tokens against a real project. Emulator: any value.
FIREBASE_WEB_API_KEY=
# Local runs against a real project only (Cloud Run uses its service account through ADC).
GOOGLE_APPLICATION_CREDENTIALS=

# ── HTTP ────────────────────────────────────────────────────────────────────────────────────
# Frontend origin: Cashfree return_url (/customer/payment/return) and links in notifications.
APP_ORIGIN=http://localhost:3000
# Absolute base URL of this API: Cashfree notify_url (/api/v1/payments/cashfree/webhook) and
# signed file URLs. Must be https in production.
PUBLIC_API_BASE_URL=http://localhost:8000
# Web origins allowed by CORS: JSON list or comma-separated, exact origins, no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# true on Cloud Run (client IP from X-Forwarded-For for rate limits).
TRUST_PROXY_HEADERS=false

# ── Secrets (>= 32 chars in staging/production; development generates deterministic values) ─
# HMAC key that signs 60-minute file content URLs.
FILE_URL_SECRET=
# HMAC key for identity-document numbers. NEVER rotate once production data exists.
PII_HASH_KEY=
# Fernet key that encrypts pickup/delivery OTPs at rest (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
OTP_ENC_KEY=
# Optional HMAC pepper applied before argon2id password hashing.
PASSWORD_PEPPER=

# ── Google Maps (server key: Geocoding API + Routes API only; never sent to browsers) ─────────
# Unset in development/test → the deterministic FAKE gazetteer is used (clearly marked).
# Unset in staging/production → maps endpoints answer 503 maps_not_configured.
GOOGLE_MAPS_SERVER_KEY=
# auto (default) | google | fake (fake is refused outside development/test)
MAPS_PROVIDER=auto
MAPS_REGION=in
MAPS_LANGUAGE=en-IN
MAPS_TIMEOUT_SECONDS=8
# States TAKI serves (JSON list or comma-separated state codes).
SERVICE_STATES=TN,KL,KA,TG,AP

# ── Payments ────────────────────────────────────────────────────────────────────────────────
# cashfree (staging/production) | dev (TEST gateway, no money moves; only with APP_ENV development/test)
PAYMENT_PROVIDER=dev
# Cashfree PG credentials (Merchant dashboard → Developers → API keys). Without all three,
# PAYMENT_PROVIDER=cashfree answers 501 payments_not_configured. The secret key also verifies
# webhook signatures.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
# Allowed clock skew for x-webhook-timestamp (seconds).
CASHFREE_WEBHOOK_TOLERANCE_SECONDS=300
CASHFREE_TIMEOUT_SECONDS=10
# Dev gateway only: key for the per-payment Approve/Decline token (defaults to FILE_URL_SECRET).
DEV_PAYMENT_SECRET=

# ── Scheduler (POST /api/v1/internal/sweep every 5 minutes) ───────────────────────────────────
# Cloud Scheduler OIDC: audience = the Cloud Run service URL; invoker = taki-scheduler@ SA email(s).
SWEEP_OIDC_AUDIENCE=
SWEEP_INVOKER_EMAILS=
# Fallback Bearer secret for local/manual runs.
CRON_SECRET=

# ── Feature flags ───────────────────────────────────────────────────────────────────────────
REQUIRE_DELIVERY_PROOF=false
REQUIRE_DRIVER_VERIFICATION=true
REQUIRE_VEHICLE_RC=true
REQUIRE_VEHICLE_RC_VERIFIED=false
# development/test only: verify agencies and drivers on submission (refused elsewhere).
DEV_AUTO_VERIFY=false
RATE_LIMITS_ENABLED=true

# ── Container (set by Cloud Run / the Dockerfile) ───────────────────────────────────────────
# PORT=8080
# WEB_CONCURRENCY=2
