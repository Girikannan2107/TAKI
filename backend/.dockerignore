# Keep the build context small and secret-free: only requirements.txt and app/ are copied.
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
tests/
app/tests_support/
scripts/
.env
.env.*
!.env.example
*.log
*.json.key
service-account*.json
Dockerfile
.dockerignore
