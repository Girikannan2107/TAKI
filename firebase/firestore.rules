rules_version = '2';
// TAKI v3 (P2 §12.1): clients never read or write Firestore directly. Every read and write goes
// through FastAPI with the Admin SDK, which bypasses these rules. Deny everything else.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
