# TAKI Travel — environment variables (names only; never commit real values).
# Copy to .env.local for local development.

# "demo" (default) runs fully in the browser with clearly labelled demo auth,
# demo payments and illustrative maps. "live" requires the integrations below.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SITE_URL=

# Firebase (future shared backend for web + React Native). Public web config only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cashfree Payments — SERVER-SIDE ONLY (never prefix with NEXT_PUBLIC_).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=
